{
  "name": "playwright-lean",
  "version": "1.0.5",
  "description": "Token-optimized CLI & Model Context Protocol (MCP) server for Playwright suite execution, on-demand failure clustering, and live browser automation",
  "main": "src/index.mjs",
  "type": "module",
  "exports": {
    ".": "./src/index.mjs",
    "./reporter": "./src/reporter.mjs",
    "./jest-reporter": {
      "import": "./src/jest-reporter.mjs",
      "require": "./src/jest-reporter.cjs",
      "default": "./src/jest-reporter.mjs"
    }
  },
  "bin": {
    "playwright-lean": "bin/playwright-lean.mjs",
    "pw-lean": "bin/playwright-lean.mjs",
    "playwright-lean-mcp": "bin/playwright-lean-mcp.mjs"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "audit": "node bin/playwright-lean.mjs audit",
    "prepublishOnly": "npm test"
  },
  "keywords": [
    "playwright",
    "mcp",
    "cli",
    "llm",
    "token-optimization",
    "testing",
    "error-clustering",
    "dossier",
    "browser-automation"
  ],
  "author": "Kerry",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KerryRitter/playwright-lean.git"
  },
  "bugs": {
    "url": "https://github.com/KerryRitter/playwright-lean/issues"
  },
  "homepage": "https://github.com/KerryRitter/playwright-lean#readme",
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "bin/",
    "src/",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "playwright": "^1.50.0"
  }
}
